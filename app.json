{
  "expo": {
    "name": "Muslim App",
    "slug": "muslim-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo2_muslim_app.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo2_muslim_app.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5132"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muslimapp.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo2_muslim_app.png",
        "backgroundColor": "#0F5132"
      },
      "package": "com.muslimapp.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/logo2_muslim_app.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrayerWidget",
              "label": "Jadwal Salat & Adzan",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Widget jadwal salat 5 waktu dan hitung mundur adzan real-time",
              "previewImage": "./assets/logo2_muslim_app.png"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c7cd9c62-3999-4ff0-943f-80acd6e5578f"
      }
    }
  }
}
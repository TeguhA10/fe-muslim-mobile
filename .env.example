# -----------------------------------------------------------------------------
# Muslim App Mobile Frontend Environment Variables (.env.example)
# Copy this file to .env, .env.local, .env.staging, or .env.production
# -----------------------------------------------------------------------------

# Active Environment Mode (development | staging | production)
EXPO_PUBLIC_ENV=development

# Backend API Endpoint Base URL
# - Local Android Emulator : http://10.0.2.2:5000/api/v1
# - Local iOS / Web        : http://localhost:5000/api/v1
# - Local Physical HP (WiFi): http://192.168.x.x:5000/api/v1
# - Staging Server         : https://staging-api.muslimapp.com/api/v1
# - Production Server      : https://api.muslimapp.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth Client ID for Mobile
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_for_mobile
